# Configure estes valores nas Environment Variables da hospedagem (Vercel).
# Use a URL do projeto Supabase.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a service_role key apenas no servidor; nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_A_SERVICE_ROLE_KEY
# Senha do painel secreto. Pode ser definida como 031, conforme solicitado.
ADMIN_PASSWORD=031
# Segredo aleatório longo usado para assinar a sessão do administrador.
ADMIN_SESSION_SECRET=COLOQUE_UM_SEGREDO_LONGO_E_ALEATORIO
